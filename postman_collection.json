{
  "info": {
    "name": "LENV API - Devnet",
    "description": "API LENV: Medicamentos, Farmácias, Pagamentos Solana Devnet",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "devnetRpc", "value": "https://api.devnet.solana.com" }
  ],
  "item": [
    {
      "name": "1. Health & Status",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/solana/health", "host": ["{{baseUrl}}"], "path": ["solana", "health"] }
          }
        },
        {
          "name": "Solana Slot",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/solana/slot", "host": ["{{baseUrl}}"], "path": ["solana", "slot"] }
          }
        },
        {
          "name": "Solana Latest Blockhash",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/solana/blockhash", "host": ["{{baseUrl}}"], "path": ["solana", "blockhash"] }
          }
        }
      ]
    },
    {
      "name": "2. Medicamentos (RF01-RF04, RF10)",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/medications", "host": ["{{baseUrl}}"], "path": ["medications"] }
          }
        },
        {
          "name": "Buscar (RF01)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medications/search?q=novalgina",
              "host": ["{{baseUrl}}"],
              "path": ["medications", "search"],
              "query": [{ "key": "q", "value": "novalgina" }]
            }
          }
        },
        {
          "name": "Detalhe por ID (RF04)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/medications/1", "host": ["{{baseUrl}}"], "path": ["medications", "1"] }
          }
        },
        {
          "name": "Farmácias do medicamento (RF06-RF08)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medications/1/pharmacies",
              "host": ["{{baseUrl}}"],
              "path": ["medications", "1", "pharmacies"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Farmácias & Geolocalização (RF05, RF09)",
      "item": [
        {
          "name": "Listar farmácias",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pharmacies", "host": ["{{baseUrl}}"], "path": ["pharmacies"] }
          }
        },
        {
          "name": "Detalhe da farmácia",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pharmacies/1", "host": ["{{baseUrl}}"], "path": ["pharmacies", "1"] }
          }
        },
        {
          "name": "Farmácias próximas (RF05)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pharmacies/nearby?lat=-23.5614&lon=-46.6559&maxKm=3",
              "host": ["{{baseUrl}}"],
              "path": ["pharmacies", "nearby"],
              "query": [
                { "key": "lat", "value": "-23.5614" },
                { "key": "lon", "value": "-46.6559" },
                { "key": "maxKm", "value": "3" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Pagamentos (RF13-RF15)",
      "item": [
        {
          "name": "Criar pedido / Checkout (RF13)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicationName\": \"Novalgina 500mg\",\n  \"pharmacyName\": \"Drogaria São Paulo\",\n  \"price\": 22.50,\n  \"distanceMeters\": 446,\n  \"walletPublicKey\": \"CIO0HVUD33MfRnymqvgm3sqGLK75icJIVnSRKqn8Uzc\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/orders", "host": ["{{baseUrl}}"], "path": ["payments", "orders"] }
          }
        },
        {
          "name": "Atualizar status → PROCESSING",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/payments/orders/LENV-0001/status",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "orders", "LENV-0001", "status"]
            }
          }
        },
        {
          "name": "Confirmar pagamento (RF15)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"transactionSignature\": \"5KJf8abc123def456ghi789\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/payments/orders/LENV-0001/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "orders", "LENV-0001", "confirm"]
            }
          }
        },
        {
          "name": "Consultar status do pedido",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/orders/LENV-0001",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "orders", "LENV-0001"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Solana Devnet (RF14)",
      "item": [
        {
          "name": "Get Health (Devnet)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getHealth\",\n  \"params\": []\n}" },
            "url": { "raw": "{{devnetRpc}}", "host": ["{{devnetRpc}}"] }
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/solana/balance/CIO0HVUD33MfRnymqvgm3sqGLK75icJIVnSRKqn8Uzc",
              "host": ["{{baseUrl}}"],
              "path": ["solana", "balance", "CIO0HVUD33MfRnymqvgm3sqGLK75icJIVnSRKqn8Uzc"]
            }
          }
        },
        {
          "name": "Request Airdrop (1 SOL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicKey\": \"CIO0HVUD33MfRnymqvgm3sqGLK75icJIVnSRKqn8Uzc\",\n  \"lamports\": 1000000000\n}"
            },
            "url": { "raw": "{{baseUrl}}/solana/airdrop", "host": ["{{baseUrl}}"], "path": ["solana", "airdrop"] }
          }
        },
        {
          "name": "Send Transaction (base64)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"signedTransaction\": \"<base64-signed-tx>\"\n}" },
            "url": { "raw": "{{baseUrl}}/solana/send", "host": ["{{baseUrl}}"], "path": ["solana", "send"] }
          }
        }
      ]
    }
  ]
}
